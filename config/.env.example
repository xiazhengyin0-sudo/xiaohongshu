# 文字模型配置：zhipu / qwen / deepseek / moonshot
TEXT_MODEL_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4

QWEN_API_KEY=
QWEN_MODEL=qwen-max

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k

# 图片模型配置：zhipu / qwen / stable_diffusion
IMAGE_MODEL_PROVIDER=zhipu

# Stable Diffusion 本地部署（可选）
SD_API_URL=http://host.docker.internal:7860

# 前端跨域，生产环境建议改成 http://你的域名:3000
CORS_ORIGINS=*

# 小红书代理 (可选)
XHS_PROXY=

# 采集间隔 (秒)
COLLECT_INTERVAL=3600
